generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  TRANSFER
  RETURN
}

enum InsightType {
  REORDER
  WASTE
  VELOCITY
  ANOMALY
  FORECAST
  SEASONAL
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  planTier  PlanTier @default(FREE)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMember[]
  categories Category[]
  suppliers  Supplier[]
  items      InventoryItem[]
  insights   AiInsight[]
  forecasts  Forecast[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships  OrganizationMember[]
  transactions InventoryTransaction[]
  auditLogs    AuditLog[]

  @@map("users")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model Category {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  color     String   @default("#6366f1")
  icon      String?
  parentId  String?
  createdAt DateTime @default(now())

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]    @relation("CategoryHierarchy")
  items    InventoryItem[]

  @@map("categories")
}

model Supplier {
  id               String   @id @default(uuid())
  orgId            String
  name             String
  contactName      String?
  email            String?
  phone            String?
  leadTimeDays     Int      @default(7)
  reliabilityScore Float    @default(1.0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items InventoryItem[]

  @@map("suppliers")
}

model InventoryItem {
  id              String   @id @default(uuid())
  orgId           String
  categoryId      String?
  supplierId      String?
  name            String
  sku             String
  barcode         String?
  description     String?
  unitOfMeasure   String   @default("each")
  unitCost        Decimal  @db.Decimal(12, 4)
  sellingPrice    Decimal? @db.Decimal(12, 4)
  reorderPoint    Int      @default(10)
  reorderQuantity Int      @default(50)
  minStockLevel   Int      @default(5)
  maxStockLevel   Int      @default(500)
  isActive        Boolean  @default(true)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org          Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     Category?              @relation(fields: [categoryId], references: [id])
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  transactions InventoryTransaction[]
  insights     AiInsight[]
  forecasts    Forecast[]

  @@unique([orgId, sku])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  orgId           String
  itemId          String
  userId          String
  type            TransactionType
  quantityDelta   Int
  unitCostAtTime  Decimal         @db.Decimal(12, 4)
  referenceNumber String?
  notes           String?
  createdAt       DateTime        @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@index([orgId, itemId, createdAt])
  @@index([orgId, type, createdAt])
  @@map("inventory_transactions")
}

model AiInsight {
  id          String          @id @default(uuid())
  orgId       String
  itemId      String?
  type        InsightType
  priority    InsightPriority @default(MEDIUM)
  title       String
  body        String
  data        Json            @default("{}")
  isDismissed Boolean         @default(false)
  generatedAt DateTime        @default(now())
  expiresAt   DateTime?

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item InventoryItem? @relation(fields: [itemId], references: [id])

  @@index([orgId, isDismissed, priority])
  @@map("ai_insights")
}

model Forecast {
  id                String   @id @default(uuid())
  orgId             String
  itemId            String
  forecastDate      DateTime
  predictedQuantity Float
  confidenceScore   Float
  modelVersion      String   @default("wma-v1")
  createdAt         DateTime @default(now())

  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([orgId, itemId, forecastDate])
  @@map("forecasts")
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  userId     String
  entityType String
  entityId   String
  action     String
  diff       Json     @default("{}")
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId, entityType, entityId])
  @@map("audit_logs")
}
