# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (used by Prisma)
# Production: use your Supabase "direct connection" URL (Transaction Pooler URL
# for serverless, or Session Pooler URL for migrations).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ──────────────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────────────

# Found in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Found in: Supabase dashboard → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Found in: Supabase dashboard → Project Settings → API → service_role secret key
# WARNING: Never expose this in client-side code. Server-only.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ──────────────────────────────────────────────────────────────────────────────
# Cron
# ──────────────────────────────────────────────────────────────────────────────

# A random secret used to authenticate Vercel Cron requests.
# Generate with: openssl rand -hex 32
# Must also be added to Vercel dashboard → Project → Settings → Environment Variables.
CRON_SECRET="your-random-secret-here"
